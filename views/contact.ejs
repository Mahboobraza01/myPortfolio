<%- include('partials/header') %>

<section class="page-hero">
  <div class="container">
    <h1>Contact <span class="highlight">Me!</span></h1>
    <!-- <p>Koi bhi project ya kaam ho, batao!</p> -->
  </div>
</section>

<section class="contact-section section">
  <div class="container">
    <div class="contact-grid">
      
      <div class="contact-info">
        <h2>Let's talk! 💬</h2>
        <p>I always ready for new Opportunies. Message Me!</p>
        <div class="contact-details">
          <div class="contact-item">
            <div class="contact-icon"><i class="fas fa-envelope"></i></div>
            <div>
              <span>Email</span>
              <strong><%= data.email %></strong>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-icon"><i class="fas fa-phone"></i></div>
            <div>
              <span>Phone</span>
              <strong><%= data.phone %></strong>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-icon"><i class="fas fa-map-marker-alt"></i></div>
            <div>
              <span>Location</span>
              <strong><%= data.location %></strong>
            </div>
          </div>
        </div>
        <div class="contact-social">
          <a href="<%= data.social.github %>" target="_blank"><i class="fab fa-github"></i></a>
          <a href="<%= data.social.linkedin %>" target="_blank"><i class="fab fa-linkedin"></i></a>
          <a href="<%= data.social.twitter %>" target="_blank"><i class="fab fa-twitter"></i></a>
        </div>
      </div>

      <div class="contact-form-wrap">
        <% if (success) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
        <% } %>
        <% if (error) { %>
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
        <% } %>

        <form action="/contact" method="POST" class="contact-form">
          <div class="form-group">
            <label>Your Naam *</label>
            <input type="text" name="name" placeholder="Apna naam likho" required />
          </div>
          <div class="form-group">
            <label>Email Address *</label>
            <input type="email" name="email" placeholder="email@example.com" required />
          </div>
          <div class="form-group">
            <label>Subject</label>
            <input type="text" name="subject" placeholder="Kya baat karni hai?" />
          </div>
          <div class="form-group">
            <label>Message *</label>
            <textarea name="message" rows="5" placeholder="Apna message likho..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-full">
            <i class="fas fa-paper-plane"></i> Send Message!
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
